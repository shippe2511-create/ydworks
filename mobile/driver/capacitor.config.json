{
  "appId": "mv.ydworks.driver",
  "appName": "YD Driver",
  "webDir": "www",
  "backgroundColor": "#070b16",
  "ios": { "contentInset": "never", "scheme": "YDDriver" },
  "android": { "allowMixedContent": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 900, "launchAutoHide": true, "backgroundColor": "#070b16", "showSpinner": false },
    "StatusBar": { "overlaysWebView": false, "style": "DARK", "backgroundColor": "#070b16" }
  }
}
